{
  "name": "shutter-interlock-workbench",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "离线的同步辐射束线快门 2-SAT 联锁认证工作台",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
